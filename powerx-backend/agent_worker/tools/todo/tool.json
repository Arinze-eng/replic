{
    "name": "todo",
    "version": "1.0.0",
    "description": "Manage a todo/task list in the work directory",
    "entry": "todo_tool.py",
    "permissions": ["fs.read", "fs.write"],
    "timeout": 15,
    "arguments": [
        {
            "name": "action",
            "type": "string",
            "description": "add, list, update, delete, clear",
            "required": true
        },
        {
            "name": "id",
            "type": "number",
            "description": "Task ID (for update/delete)",
            "required": false
        },
        {
            "name": "title",
            "type": "string",
            "description": "Task title (for add/update)",
            "required": false
        },
        {
            "name": "status",
            "type": "string",
            "description": "Task status: todo, in_progress, done",
            "required": false
        },
        {
            "name": "priority",
            "type": "string",
            "description": "Priority: low, medium, high, critical",
            "required": false
        }
    ],
    "output": {
        "type": "object",
        "description": "Updated todo list"
    }
}